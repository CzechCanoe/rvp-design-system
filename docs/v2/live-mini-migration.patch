+++ b/packages/client/src/components/AppShell.tsx
@@ -0,0 +1,62 @@
+import { useEffect, type ReactNode } from 'react';
+import { SHARED_VERSION } from '@c123-live-mini/shared';
+import { Header, PageLayout } from '@czechcanoe/rvp-design-system';
+import { branding } from '../config/branding';
+
+/**
+ * Page frame. Pages render it themselves so a page can put its own full-width
+ * band (EventHeader) under the app header. `stickyBand` puts the band into the
+ * sticky header area (for a header that condenses on scroll). `nav` is the
+ * full-width navigation band under it (days, classes); it scrolls away.
+ * `padded` gives the content the DS gutter, so it lines up with the EventHeader content.
+ */
+export function AppShell({
+  banner,
+  stickyBand = false,
+  nav,
+  bottomBar,
+  padded = false,
+  children,
+}: {
+  banner?: ReactNode;
+  stickyBand?: boolean;
+  nav?: ReactNode;
+  bottomBar?: ReactNode;
+  padded?: boolean;
+  children: ReactNode;
+}) {
+  // Anything scrolled to (class carousel, focused row) lands below the sticky
+  // app header (48 px) + condensed EventHeader, not under them.
+  useEffect(() => {
+    if (!stickyBand) return;
+    const root = document.documentElement;
+    root.style.scrollPaddingTop = 'calc(48px + var(--csk-event-header-condensed-h))';
+    return () => {
+      root.style.scrollPaddingTop = '';
+    };
+  }, [stickyBand]);
+
+  return (
+    <PageLayout
+      variant="tribuna"
+      maxWidth="lg"
+      padded={padded}
+      header={
+        <>
+          <Header
+            variant="satellite"
+            appName={branding.appName}
+            homeLink={branding.homeLink}
+            homeLinkLabel={branding.homeLinkLabel}
+          />
+          {stickyBand && banner}
+        </>
+      }
+      banner={stickyBand ? nav : (banner ?? nav)}
+      bottomBar={bottomBar}
+      footer={<>Powered by c123-live-mini (shared v{SHARED_VERSION})</>}
+    >
+      {children}
+    </PageLayout>
+  );
+}
